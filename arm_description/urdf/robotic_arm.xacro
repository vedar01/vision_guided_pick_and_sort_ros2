<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="base_length" value="0.4" />
    <xacro:property name="base_width" value="0.4" />
    <xacro:property name="base_height" value="0.1" />
    <xacro:property name="shoulder_length" value="0.5" />
    <xacro:property name="shoulder_radius" value="0.1" />
    <xacro:property name="arm_radius" value="0.05" />
    <xacro:property name="arm_length" value="0.6" />
    <xacro:property name="elbow_radius" value="0.05" />
    <xacro:property name="elbow_length" value="0.1" />
    <xacro:property name="forearm_radius" value="0.05" />
    <xacro:property name="forearm_length" value="0.5" />
    <xacro:property name="wrist_length" value="0.1" />
    <xacro:property name="wrist_width" value="0.1" />
    <xacro:property name="wrist_height" value="0.05" />
    <xacro:property name="hand_length" value="0.1" />
    <xacro:property name="hand_width" value="0.1" />
    <xacro:property name="hand_height" value="0.02" />

    <link name="world" />

    <link name="base_link" >
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0" />
            <material name="grey" />
        </visual>

        <collision>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0" />
        </collision>

        <xacro:box_inertia m="5.0" x="${base_length}" y="${base_width}" z="${base_height}"
                           o_xyz="0 0 ${base_height / 2.0}" o_rpy="0 0 0" />
    </link>

    <link name="shoulder_link">
        <visual>
            <geometry>
                <cylinder radius="${shoulder_radius}" length="${shoulder_length}" />
            </geometry>
            <origin xyz="0 0 ${shoulder_length / 2.0}" rpy="0 0 0" />
            <material name="grey" />
        </visual>

        <collision>
            <geometry>
                <cylinder radius="${shoulder_radius}" length="${shoulder_length}" />
            </geometry>
            <origin xyz="0 0 ${shoulder_length / 2.0}" rpy="0 0 0" />
        </collision>

        <xacro:cylinder_inertia m="1.0" r="${shoulder_radius}" h="${shoulder_length}" 
                                    o_xyz="0 0 ${shoulder_length / 2.0}" o_rpy="0 0 0" />
    </link>

    <link name="arm_link">
        <visual>
            <geometry>
                <cylinder radius="${arm_radius}" length="${arm_length}" />
            </geometry>
            <origin xyz="0 0 ${arm_length / 2.0}" rpy="0 0 0" />
            <material name="grey" />
        </visual>

        <collision>
            <geometry>
                <cylinder radius="${arm_radius}" length="${arm_length}" />
            </geometry>
            <origin xyz="0 0 ${arm_length / 2.0}" rpy="0 0 0" />
        </collision>

        <xacro:cylinder_inertia m="1.0" r="${arm_radius}" h="${arm_length}"
                                    o_xyz="0 0 ${arm_length / 2.0}" o_rpy="0 0 0" />
    </link>

    <link name="elbow_link">
        <visual>
            <geometry>
                <cylinder radius="${elbow_radius}" length="${elbow_length}" />
            </geometry>
            <origin xyz="0 0 ${elbow_length / 2.0}" rpy="0 0 0" />
            <material name="grey" />
        </visual>

        <collision>
            <geometry>
                <cylinder radius="${elbow_radius}" length="${elbow_length}" />
            </geometry>
            <origin xyz="0 0 ${elbow_length / 2.0}" rpy="0 0 0" />
        </collision>

        <xacro:cylinder_inertia m="1.0" r="${elbow_radius}" h="${elbow_length}"
                                    o_xyz="0 0 ${elbow_length / 2.0}" o_rpy="0 0 0" />
    </link>

    <link name="forearm_link">
        <visual>
            <geometry>
                <cylinder radius="${forearm_radius}" length="${forearm_length}" />
            </geometry>
            <origin xyz="0 0 ${forearm_length / 2.0}" rpy="0 0 0" />
            <material name="grey" />
        </visual>

        <collision>
            <geometry>
                <cylinder radius="${forearm_radius}" length="${forearm_length}" />
            </geometry>
            <origin xyz="0 0 ${forearm_length / 2.0}" rpy="0 0 0" />
        </collision>

        <xacro:cylinder_inertia m="1.0" r="${forearm_radius}" h="${forearm_length}"
                                    o_xyz="0 0 ${forearm_length / 2.0}" o_rpy="0 0 0" />
    </link>

    <link name="wrist_link" >
        <visual>
            <geometry>
                <box size="${wrist_length} ${wrist_width} ${wrist_height}" />
            </geometry>
            <origin xyz="0 0 ${wrist_height / 2.0}" rpy="0 0 0" />
            <material name="grey" />
        </visual>

        <collision>
            <geometry>
                <box size="${wrist_length} ${wrist_width} ${wrist_height}" />
            </geometry>
            <origin xyz="0 0 ${wrist_height / 2.0}" rpy="0 0 0" />
        </collision>

        <xacro:box_inertia m="0.5" x="${wrist_length}" y="${wrist_width}" z="${wrist_height}"
                           o_xyz="0 0 ${wrist_height / 2.0}" o_rpy="0 0 0" />
    </link>

    <link name="hand_link" >
        <visual>
            <geometry>
                <box size="${hand_length} ${hand_width} ${hand_height}" />
            </geometry>
            <origin xyz="0 0 ${hand_height / 2.0}" rpy="0 0 0" />
            <material name="grey" />
        </visual>

        <collision>
            <geometry>
                <box size="${hand_length} ${hand_width} ${hand_height}" />
            </geometry>
            <origin xyz="0 0 ${hand_height / 2.0}" rpy="0 0 0" />
        </collision>

        <xacro:box_inertia m="0.5" x="${hand_length}" y="${hand_width}" z="${hand_height}"
                           o_xyz="0 0 ${hand_height / 2.0}" o_rpy="0 0 0" />
    </link>

    <link name="tool_link" />

    <joint name="world_base_joint" type="fixed">
        <parent link="world" />
        <child link="base_link" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

    <joint name="base_shoulder_joint" type="revolute">
        <parent link="base_link" />
        <child link="shoulder_link" />
        <origin xyz="0 0 ${base_height}" rpy="0 0 0" />
        <axis xyz="0 0 1" />
        <limit effort="1000.0" velocity="1.0" lower="${-pi}" upper="${pi}" />
        <dynamics friction="0.3" damping="0.3" />
    </joint>

    <joint name="shoulder_arm_joint" type="revolute">
        <parent link="shoulder_link" />
        <child link="arm_link" />
        <origin xyz="0 0 ${shoulder_length}" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit effort="1000.0" velocity="1.0" lower="0.0" upper="2.5" />
        <dynamics friction="0.3" damping="0.3" />
    </joint>

    <joint name="arm_elbow_joint" type="revolute">
        <parent link="arm_link" />
        <child link="elbow_link" />
        <origin xyz="0 0 ${arm_length}" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit effort="1000.0" velocity="1.0" lower="0.0" upper="2.5" />
        <dynamics friction="0.3" damping="0.3" />
    </joint>

    <joint name="elbow_forearm_joint" type="revolute">
        <parent link="elbow_link" />
        <child link="forearm_link" />
        <origin xyz="0 0 ${elbow_length}" rpy="0 0 0" />
        <axis xyz="0 0 1" />
        <limit effort="1000.0" velocity="1.0" lower="${-pi}" upper="${pi}" />
        <dynamics friction="0.3" damping="0.3" />
    </joint>

    <joint name="forearm_wrist_joint" type="revolute">
        <parent link="forearm_link" />
        <child link="wrist_link" />
        <origin xyz="0 0 ${forearm_length}" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit effort="1000.0" velocity="1.0" lower="${-pi / 2.0}" upper="${pi / 2.0}" />
        <dynamics friction="0.3" damping="0.3" />
    </joint>

    <joint name="wrist_hand_joint" type="continuous">
        <parent link="wrist_link" />
        <child link="hand_link" />
        <origin xyz="0 0 ${wrist_height}" rpy="0 0 0" />
        <dynamics friction="0.3" damping="0.3" />
        <axis xyz="0 0 1" />
    </joint>

    <joint name="hand_tool_joint" type="fixed">
        <parent link="hand_link" />
        <child link="tool_link" />
        <origin xyz="0 0 ${hand_height}" />
    </joint>

</robot>