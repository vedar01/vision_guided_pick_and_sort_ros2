<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="gripper_base_length" value="0.2" />
    <xacro:property name="gripper_base_width" value="0.06" />
    <xacro:property name="gripper_base_height" value="0.02" />
    <xacro:property name="gripper_finger_length" value="0.02" />
    <xacro:property name="gripper_finger_width" value="0.06" />
    <xacro:property name="gripper_finger_height" value="0.08" />

    <link name="gripper_base_link" >
        <visual>
            <geometry>
                <box size="${gripper_base_length} ${gripper_base_width} ${gripper_base_height}" />
            </geometry>
            <origin xyz="0 0 ${gripper_base_height / 2.0}" rpy="0 0 0" />
            <material name="grey" />
        </visual>

        <collision>
            <geometry>
                <box size="${gripper_base_length} ${gripper_base_width} ${gripper_base_height}" />
            </geometry>
            <origin xyz="0 0 ${gripper_base_height / 2.0}" rpy="0 0 0" />
        </collision>

        <xacro:box_inertia m="1.0" x="${gripper_base_length}" 
                            y="${gripper_base_width}" z="${gripper_base_height}"
                           o_xyz="0 0 ${gripper_base_height / 2.0}" o_rpy="0 0 0" />
    </link>

    <link name="gripper_left_finger_link" >
        <visual>
            <geometry>
                <box size="${gripper_finger_length} ${gripper_finger_width} ${gripper_finger_height}" />
            </geometry>
            <origin xyz="0 0 ${gripper_finger_height / 2.0}" rpy="0 0 0" />
            <material name="grey" />
        </visual>

        <collision>
            <geometry>
                <box size="${gripper_finger_length} ${gripper_finger_width} ${gripper_finger_height}" />
            </geometry>
            <origin xyz="0 0 ${gripper_finger_height / 2.0}" rpy="0 0 0" />
        </collision>

        <xacro:box_inertia m="0.5" x="${gripper_finger_length}" 
                           y="${gripper_finger_width}" z="${gripper_finger_height}"
                           o_xyz="0 0 ${gripper_finger_height / 2.0}" o_rpy="0 0 0" />
    </link>

    <link name="gripper_right_finger_link" >
        <visual>
            <geometry>
                <box size="${gripper_finger_length} ${gripper_finger_width} ${gripper_finger_height}" />
            </geometry>
            <origin xyz="0 0 ${gripper_finger_height / 2.0}" rpy="0 0 0" />
            <material name="grey" />
        </visual>

        <collision>
            <geometry>
                <box size="${gripper_finger_length} ${gripper_finger_width} ${gripper_finger_height}" />
            </geometry>
            <origin xyz="0 0 ${gripper_finger_height / 2.0}" rpy="0 0 0" />
        </collision>

        <xacro:box_inertia m="0.5" x="${gripper_finger_length}" 
                           y="${gripper_finger_width}" z="${gripper_finger_height}"
                           o_xyz="0 0 ${gripper_finger_height / 2.0}" o_rpy="0 0 0" />
    </link>

    <joint name="gripper_base_joint" type="fixed">
        <parent link="tool_link" />
        <child link="gripper_base_link" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

    <joint name="gripper_left_finger_joint" type="prismatic">
        <parent link="gripper_base_link" />
        <child link="gripper_left_finger_link" />
        <origin xyz="-0.07 0 ${gripper_base_height}" rpy="0 0 0" />
        <axis xyz="1 0 0" />
        <limit effort="1000.0" velocity="1.0"
               lower="0.0" upper="0.06" />
        <dynamics damping="20.0" friction="2.5" />
    </joint>

    <joint name="gripper_right_finger_joint" type="prismatic">
        <parent link="gripper_base_link" />
        <child link="gripper_right_finger_link" />
        <origin xyz="0.07 0 ${gripper_base_height}" rpy="0 0 0" />
        <axis xyz="-1 0 0" />
        <limit effort="1000.0" velocity="1.0"
               lower="0.0" upper="0.06" />
        <dynamics damping="20.0" friction="2.5" />
    </joint>

</robot>