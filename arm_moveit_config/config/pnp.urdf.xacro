<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="pnp">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import pnp urdf file -->
    <xacro:include filename="$(find arm_description)/urdf/pnp.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="pnp.ros2_control.xacro" />


    <xacro:pnp_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
